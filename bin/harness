#!/usr/bin/env bash
# ==============================================================================
# agent-harness: bin/harness
# Universal Multi-Call CLI Dispatcher & AI Engineering Engine
# ==============================================================================

set -eo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [ -L "${SOURCE}" ]; do
    DIR="$(cd -P "$(dirname "${SOURCE}")" && pwd)"
    SOURCE="$(readlink "${SOURCE}")"
    [[ ${SOURCE} != /* ]] && SOURCE="${DIR}/${SOURCE}"
done
HARNESS_ROOT="$(cd -P "$(dirname "${SOURCE}")/.." && pwd)"
SCRIPTS_DIR="${HARNESS_ROOT}/core/scripts"

source "${SCRIPTS_DIR}/lib/utils.sh"
source "${SCRIPTS_DIR}/lib/config.sh"
source "${SCRIPTS_DIR}/lib/git.sh"
source "${SCRIPTS_DIR}/lib/issues.sh"

INVOKED_NAME="$(basename "$0")"

# 1. Multi-call profile resolution
case "${INVOKED_NAME}" in
    harness|agh|agent-harness)
        # Default harness binary names - do not treat as a profile alias
        ;;
    *)
        export STACK_PROFILE="${INVOKED_NAME}"
        ;;
esac

# 2. Check for explicit --profile / -p flag
if [ "${1:-}" = "--profile" ] || [ "${1:-}" = "-p" ]; then
    if [ -z "${2:-}" ]; then
        log_error "The ${1} option requires a profile name."
        exit 1
    fi
    export STACK_PROFILE="$2"
    shift 2
fi

# 3. Active profile resolution
PROFILE_RESOLUTION="$(get_active_profile_with_reason)"
ACTIVE_PROFILE="${PROFILE_RESOLUTION%%$'\t'*}"
# Subcommands run with STACK_PROFILE already exported, which would make every one of them
# report "resolved by the environment". The reason travels with it so `harness config
# validate` and `harness doctor` can still say where the profile actually came from.
export STACK_PROFILE="${ACTIVE_PROFILE}"
export STACK_PROFILE_REASON="${PROFILE_RESOLUTION#*$'\t'}"

show_help() {
    print_banner
    cat << USAGE_EOF

${BOLD}Usage:${RESET}
  harness [options] <command> [arguments...]
  ${DIM}(alias: agh, agent-harness)${RESET}
  ${DIM}(or via profile alias: ${ACTIVE_PROFILE} <command> [arguments...])${RESET}

${BOLD}Options:${RESET}
  --profile, -p <name>    Explicitly specify active profile (Default: ${CYAN}${ACTIVE_PROFILE}${RESET})

${BOLD}Core Commands:${RESET}
  ${GREEN}doctor${RESET}        Diagnose environment, symlinks, configs, harnesses & tools
                harness doctor [--fix] [--check-auth]

  ${GREEN}context${RESET}       Extract fast, token-efficient workspace signals (<1s) for LLMs
                harness context [--json]

  ${GREEN}config${RESET}        Report the resolved configuration and validate its structure
                harness config validate

  ${GREEN}spec${RESET}          Spec-Driven Development & Living Delta Specs management
                harness spec status [--json]
                harness spec create <issue_key> <slug> [--module <name>]
                harness spec verify [spec_path]
                harness spec archive <module_name> [spec_path]

  ${GREEN}qa${RESET}            Run test suites, TDD loops, linters, and type checkers
                harness qa test [path] [args...]
                harness qa tdd  <test_path>
                harness qa scan [--staged|--diff|--branch|--all]
                harness qa lint
                harness qa types
                harness qa all

  ${GREEN}scan${RESET}          Run JSON-driven static Landmine & Security scanner
                harness scan [--staged|--diff|--branch|--all] [--base <ref>]
                harness scan --install-hook [--force]

  ${GREEN}worktree${RESET}      Isolate feature/bug development in clean parallel directories
                harness worktree create <type> <issue_key> <slug> [--base <branch>]
                harness worktree list
                harness worktree seed <path>
                harness worktree remove <issue_key|path> [--force] [--dry-run]

  ${GREEN}branch${RESET}        Manage & validate issue-driven branches
                harness branch create <type> <issue_key> <slug> [--base <branch>]
                harness branch check [branch]
                harness branch list

  ${GREEN}commit${RESET}        Build conventional commit message with issue prefix
                harness commit build <type> "<message>"
                harness commit check [commit_hash]

  ${GREEN}debt${RESET}          Scan & harvest technical debt markers ("# pragmatism:", "# defer:")
                harness debt [--json] [--all] [--path <path>]

  ${GREEN}receipt${RESET}       Record private local workflow lifecycle events
                harness receipt start <implement|fix|investigate|orchestrate> [--issue <token>]
                harness receipt phase <run_id> <phase> <status>
                harness receipt finish <run_id> <outcome>
                harness receipt list
                harness receipt show <run_id>
                harness receipt prune [--keep <count>]

  ${GREEN}ledger${RESET}        Keep a durable append-only record of a workflow run
                harness ledger start <run_id>
                harness ledger append <run_id> <kind> <text>
                harness ledger show <run_id>
                harness ledger rulings <run_id>
                harness ledger signature                (failure text on stdin)
                harness ledger failure <run_id> [label] (failure text on stdin)

  ${GREEN}ship${RESET}          Run pre-flight checks, push the branch, and open a Pull Request
                harness ship [target_branch] [--yes] [--dry-run]
                ${DIM}(alias: pr)${RESET}

  ${GREEN}sync${RESET}          Report or repair drift in installed skill surfaces
                harness sync [--target <path>] [--global] [--expert]
                harness sync --check

  ${GREEN}init${RESET}          Initialize agent harness in current repository
                harness init [--recipe <name>]

  ${GREEN}completion${RESET}    Install shell autocompletion for Zsh and Bash
                harness completion install

  ${GREEN}version${RESET}       Report the installed version, checkout and revision
                harness version

  ${GREEN}upgrade${RESET}       Update the checkout and re-sync every managed surface
                harness upgrade [--check]
USAGE_EOF
}

COMMAND="${1:-}"
if [ -z "${COMMAND}" ] || [ "${COMMAND}" = "-h" ] || [ "${COMMAND}" = "--help" ]; then
    show_help
    exit 0
fi
shift || true

case "${COMMAND}" in
    doctor)
        exec "${SCRIPTS_DIR}/stack-doctor.sh" "$@"
        ;;
    context)
        exec "${SCRIPTS_DIR}/stack-context.sh" "$@"
        ;;
    config)
        exec "${SCRIPTS_DIR}/stack-config.sh" "$@"
        ;;
    spec)
        exec "${SCRIPTS_DIR}/stack-spec.sh" "$@"
        ;;
    branch)
        exec "${SCRIPTS_DIR}/stack-branch.sh" "$@"
        ;;
    commit)
        exec "${SCRIPTS_DIR}/stack-commit.sh" "$@"
        ;;
    scan)
        exec "${SCRIPTS_DIR}/stack-scan.sh" "$@"
        ;;
    qa)
        exec "${SCRIPTS_DIR}/stack-qa.sh" "$@"
        ;;
    tdd)
        exec "${SCRIPTS_DIR}/stack-qa.sh" tdd "$@"
        ;;
    worktree)
        exec "${SCRIPTS_DIR}/stack-worktree.sh" "$@"
        ;;
    debt)
        exec "${SCRIPTS_DIR}/stack-debt.sh" "$@"
        ;;
    receipt)
        exec "${SCRIPTS_DIR}/stack-receipt.sh" "$@"
        ;;
    ledger)
        exec "${SCRIPTS_DIR}/stack-ledger.sh" "$@"
        ;;
    ship|pr)
        exec "${SCRIPTS_DIR}/stack-pr.sh" "$@"
        ;;
    completion)
        exec "${SCRIPTS_DIR}/stack-completion.sh" "$@"
        ;;
    sync)
        exec "${SCRIPTS_DIR}/stack-sync.sh" "$@"
        ;;
    version)
        exec "${SCRIPTS_DIR}/stack-version.sh" "$@"
        ;;
    upgrade)
        exec "${SCRIPTS_DIR}/stack-upgrade.sh" "$@"
        ;;
    init)
        # Initializing a repository means initializing its root: AGENTS.md, the CLAUDE.md and
        # GEMINI.md symlinks, rules/, stack.config.json and the .gitignore entry all belong
        # there, and the skill surfaces are only found there. This passed $(pwd), so running
        # it from a subdirectory installed a whole second harness inside that subdirectory --
        # a second .gitignore included -- and said nothing about where any of it went.
        #
        # Outside a repository get_repo_root returns the directory it was given, so nothing
        # changes for a target that is not a checkout; install.sh reports that separately.
        # An explicit --target still arrives after this one and wins, as it always did.
        INIT_CWD="$(pwd -P)"
        INIT_TARGET="$(get_repo_root "${INIT_CWD}")"
        if [ "${INIT_TARGET}" != "${INIT_CWD}" ]; then
            log_info "Initializing the repository root rather than this directory: ${INIT_TARGET}"
        fi
        exec "${HARNESS_ROOT}/install.sh" --target "${INIT_TARGET}" "$@"
        ;;
    *)
        # Check custom commands directory if configured
        CUSTOM_DIR="$(get_profile_value "customCommandsDir" "")"
        if [ -n "${CUSTOM_DIR}" ] && [ -f "${CUSTOM_DIR}/${COMMAND}.sh" ]; then
            exec "${CUSTOM_DIR}/${COMMAND}.sh" "$@"
        elif [ -n "${CUSTOM_DIR}" ] && [ -f "${CUSTOM_DIR}/${COMMAND}" ]; then
            exec "${CUSTOM_DIR}/${COMMAND}" "$@"
        else
            log_error "Unknown command '${COMMAND}'."
            show_help
            exit 1
        fi
        ;;
esac
