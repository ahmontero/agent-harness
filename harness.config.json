{
  "$schema": "./schema.json",
  "project": {
    "name": "agent-harness",
    "defaultProfile": "harness"
  },
  "profiles": {
    "harness": {
      "displayName": "Agent Harness",
      "detect": {
        "files": [
          "package.json"
        ]
      },
      "git": {
        "trunkBranch": "main",
        "releaseBranchPrefix": "release/"
      },
      "qa": {
        "testCommand": "env -u STACK_PROFILE npm test",
        "tddCommand": "bash test/test_cli.sh",
        "lintCommand": "./setup --verify",
        "typeCheckCommand": "bash -n bin/harness bin/agh bin/agent-harness core/scripts/*.sh core/scripts/lib/*.sh install.sh setup test/test_cli.sh scripts/record-demo.sh"
      },
      "ci": {
        "provider": "github"
      },
      "orchestrate": {
        "models": {
          "implementer": "sonnet",
          "reviewer": "opus"
        }
      },
      "rules": {
        "invariants": "./rules/floor.md",
        "landmines": "./rules/landmines.md",
        "scanner": "./rules/landmines.json"
      }
    }
  }
}
